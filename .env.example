# ── Neon Postgres ──────────────────────────────────────────────────────────
# Pooled DSN from your Neon dashboard (Server → Pooled connection string).
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Auth (single admin) ────────────────────────────────────────────────────
# Session signing key. Generate with:  openssl rand -base64 32
AUTH_SECRET=
# The photographer's login credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ── Image uploads (Vercel Blob) ────────────────────────────────────────────
# Vercel project → Storage → Create Blob store → connect → copy the token.
BLOB_READ_WRITE_TOKEN=
